{
	"FileVersion": 3,
	"Version": 5,
	"VersionName": "1.4",
	"FriendlyName": "AI Editor Stack (Unreal MCP + Toolsets + VibeUE)",
	"Description": "Engine-wide switch: enables Epic's Unreal MCP server, the engine AI toolsets and VibeUE in every project, editor only (nothing is packaged into games). Adds its own Python toolsets (SketchfabTools), a Tools > AI Editor Stack menu and an MCP guard that starts the server when auto-start did not, or takes the port over once another editor frees it. To turn it off for one project, untick it in Edit > Plugins. GameFeaturesToolset and ConversationToolset are left out on purpose (they pull in the GameFeatures plugin, which raises a GameFeatureData load error in projects without Game Features) - enable them per project if needed.",
	"Category": "Editor",
	"CreatedBy": "Metraveer",
	"CreatedByURL": "https://github.com/metraveer/ue-ai-editor-stack",
	"DocsURL": "https://dev.epicgames.com/documentation/unreal-engine/unreal-mcp-in-unreal-editor",
	"CanContainContent": true,
	"EditorOnly": true,
	"IsBetaVersion": false,
	"IsExperimentalVersion": false,
	"Installed": true,
	"EnabledByDefault": true,
	"Plugins": [
		{ "Name": "ModelContextProtocol", "Enabled": true, "TargetAllowList": [ "Editor" ] },
		{ "Name": "ToolsetRegistry", "Enabled": true, "TargetAllowList": [ "Editor" ] },
		{ "Name": "PythonScriptPlugin", "Enabled": true, "TargetAllowList": [ "Editor" ] },
		{ "Name": "AIModuleToolset", "Enabled": true, "TargetAllowList": [ "Editor" ] },
		{ "Name": "AnimationAssistantToolset", "Enabled": true, "TargetAllowList": [ "Editor" ] },
		{ "Name": "AutomationTestToolset", "Enabled": true, "TargetAllowList": [ "Editor" ] },
		{ "Name": "ConfigSettingsToolset", "Enabled": true, "TargetAllowList": [ "Editor" ] },
		{ "Name": "DataRegistryToolset", "Enabled": true, "TargetAllowList": [ "Editor" ] },
		{ "Name": "DataflowAgent", "Enabled": true, "TargetAllowList": [ "Editor" ] },
		{ "Name": "EditorToolset", "Enabled": true, "TargetAllowList": [ "Editor" ] },
		{ "Name": "GameplayTagsToolset", "Enabled": true, "TargetAllowList": [ "Editor" ] },
		{ "Name": "GASToolsets", "Enabled": true, "TargetAllowList": [ "Editor" ] },
		{ "Name": "MCPClientToolset", "Enabled": true, "TargetAllowList": [ "Editor" ] },
		{ "Name": "NiagaraToolsets", "Enabled": true, "TargetAllowList": [ "Editor" ] },
		{ "Name": "PCGToolset", "Enabled": true, "TargetAllowList": [ "Editor" ] },
		{ "Name": "PhysicsToolsets", "Enabled": true, "TargetAllowList": [ "Editor" ] },
		{ "Name": "PluginToolset", "Enabled": true, "TargetAllowList": [ "Editor" ] },
		{ "Name": "SemanticSearchToolset", "Enabled": true, "TargetAllowList": [ "Editor" ] },
		{ "Name": "SlateInspectorToolset", "Enabled": true, "TargetAllowList": [ "Editor" ] },
		{ "Name": "StateTreeToolset", "Enabled": true, "TargetAllowList": [ "Editor" ] },
		{ "Name": "UMGToolSet", "Enabled": true, "TargetAllowList": [ "Editor" ] },
		{ "Name": "WorldConditionsToolset", "Enabled": true, "TargetAllowList": [ "Editor" ] },
		{ "Name": "LiveCodingToolset", "Enabled": true, "TargetAllowList": [ "Editor" ] },
		{ "Name": "MVVMToolset", "Enabled": true, "TargetAllowList": [ "Editor" ] },
		{ "Name": "SequencerAnimMixerToolset", "Enabled": true, "TargetAllowList": [ "Editor" ] },
		{ "Name": "VibeUE", "Enabled": true, "TargetAllowList": [ "Editor" ] }
	]
}
